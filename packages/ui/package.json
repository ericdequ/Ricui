{
  "name": "@ric/ui",
  "version": "0.1.0",
  "description": "Unified RIC UI package — single import for tokens, components, icons, and emoji",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./tokens": "./src/tokens.js",
    "./icons": "./src/icons.js",
    "./emoji": "./src/emoji.js",
    "./core": "./src/core.js"
  },
  "keywords": ["ric", "ui", "design-system", "components", "tokens", "icons"],
  "license": "MIT",
  "files": ["src"],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ric/emoji": "0.1.0",
    "@ric/icons": "0.1.0",
    "@ric/ui-core": "0.1.0",
    "@ric/ui-tokens": "0.1.0"
  }
}
