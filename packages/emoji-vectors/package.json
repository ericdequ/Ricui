{
  "name": "@ric/emoji-vectors",
  "version": "0.1.0",
  "type": "module",
  "description": "Emoji ↔ unicode ↔ feature-vector space: ground a symbol in a small semantic vector, compose emoji strings, compare by cosine, and project to 2-D for visualization. Extends @ric/emoji.",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./baked": "./src/baked.js",
    "./catalog": "./src/catalog.js",
    "./center": "./src/center.js",
    "./quantize": "./src/quantize.js",
    "./serve": "./src/serve.js",
    "./react": "./src/react.jsx",
    "./names": "./src/names.js",
    "./unicode": "./src/unicode.js"
  },
  "scripts": {
    "bake": "node scripts/bake.mjs",
    "test": "node --test test/*.test.mjs",
    "build-names": "node scripts/build-names.mjs",
    "build-unicode": "node scripts/build-unicode.mjs"
  },
  "dependencies": {
    "@ric/emoji": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericdequ/Ricui.git",
    "directory": "packages/emoji-vectors"
  },
  "license": "MIT",
  "files": [
    "src",
    "scripts"
  ]
}
