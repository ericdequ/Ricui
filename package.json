{
  "name": "ricui-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Unified RIC UI workspace — monorepo for @ric/* design-system packages",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check:imports": "node ./scripts/verify-imports.mjs",
    "test": "node ./scripts/verify-imports.mjs",
    "publish:all": "npm publish --workspaces",
    "version:patch": "npm version patch --workspaces --no-git-tag-version"
  }
}
